{
  "name": "docsync",
  "version": "0.1.0",
  "description": "Keep project docs up to date by reading git changes and using an LLM to update managed markdown sections.",
  "type": "module",
  "bin": {
    "docsync": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["docs", "documentation", "git", "llm", "cli"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.2.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "prompts": "^2.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/prompts": "^2.4.9",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
